    foaf:depiction <https://api.iconify.design/carbon:property-relationship.svg?color=%230085C6&format=svg> .

pv:email a owl:DatatypeProperty ;
    rdfs:label "email"@en ;
    rdfs:comment "The e-mail of an agent."@en ;
