pv:country a owl:ObjectProperty ;
    rdfs:label "country"@en ;
    phys:edgeCollectionName "country" ;
    rdfs:comment "The country where the supplier is located."@en ;
    rdfs:domain pv:Supplier ;
    rdfs:isDefinedBy pv: ;
