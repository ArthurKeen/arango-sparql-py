# Copy to .env (which is gitignored) and edit for your environment.

# --- ArangoDB connection ----------------------------------------------------
ARANGO_URL=http://localhost:8529
ARANGO_DB=_system
ARANGO_USER=root
ARANGO_PASSWORD=rootpw

# --- Service ---------------------------------------------------------------
# Single switch that flips the service from local-dev to public-internet
# defaults (matches arango-cypher-py's ARANGO_CYPHER_PUBLIC_MODE).
ARANGO_SPARQL_PUBLIC_MODE=
# Comma-separated origin list, or '*' for local dev. With '*' the
# credentialed-CORS toggle is forced off (see service/app.py for the matrix).
CORS_ALLOWED_ORIGINS=*
ARANGO_SPARQL_CORS_CREDENTIALS=
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=100

# --- LLM providers (optional, only needed for the nl2sparql pipeline) ------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Test gates ------------------------------------------------------------
RUN_INTEGRATION=
RUN_CROSS=
RUN_W3C=
RUN_EVAL=
